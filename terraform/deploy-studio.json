{
  "schema_version": 1,
  "project_id": "oracle-ai-accelerator",
  "terraform": {
    "path": "terraform",
    "package_oci_credentials": true
  },
  "capabilities": {
    "compartment_modes": [
      "new",
      "existing"
    ],
    "requires_genai_region": true,
    "database_profile": "new"
  },
  "form": {
    "fields": [
      {
        "name": "autonomous_database_admin_password",
        "label": "Database ADMIN password",
        "type": "password",
        "required": true,
        "secret": true,
        "group": "database"
      },
      {
        "name": "autonomous_database_wallet_password",
        "label": "Database wallet password",
        "type": "password",
        "required": true,
        "secret": true,
        "group": "database"
      },
      {
        "name": "application_username",
        "label": "Application username",
        "type": "text",
        "required": true,
        "default": "admin",
        "group": "application_vm"
      },
      {
        "name": "autonomous_database_developer_password",
        "label": "Application password",
        "type": "password",
        "required": true,
        "secret": true,
        "group": "application_vm"
      }
    ]
  },
  "presentation": {
    "title": "Oracle AI Accelerator",
    "summary": "Deploys an OCI solution for document, image, audio and text intelligence with Oracle AI Database, Generative AI and vector workflows.",
    "tags": ["Oracle AI Database 26ai", "Generative AI", "Agents", "Select AI"],
    "image": "/assets/oracle-ai-accelerator.png",
    "image_alt": "Oracle AI Accelerator sign-in preview",
    "href": "https://github.com/jgangini/oracle-ai-accelerator"
  },
  "run_steps": [
    {"key": "queue", "label": "Queue"},
    {"key": "credentials", "label": "OCI credentials"},
    {"key": "compartment", "label": "Compartment"},
    {"key": "policies", "label": "IAM policies"},
    {"key": "stack", "label": "Resource Manager stack"},
    {"key": "plan", "label": "Terraform plan"},
    {"key": "apply", "label": "Terraform apply"},
    {"key": "network", "label": "Network and VCN"},
    {"key": "bucket", "label": "Object Storage"},
    {"key": "compute", "label": "Application VM"},
    {"key": "database", "label": "Autonomous Database"},
    {"key": "wallet", "label": "Database wallet"},
    {"key": "application", "label": "Application setup"},
    {"key": "artifacts", "label": "Access artifacts"},
    {"key": "email", "label": "Access email"},
    {"key": "complete", "label": "Ready"}
  ],
  "outputs": [
    "application_url",
    "ssh_user",
    "adb_db_name",
    "autonomous_database_id",
    "bucket_name"
  ],
  "artifacts": [
    "adb_wallet.zip",
    "ssh-private-key.pem",
    "connection-summary.txt",
    "application-password.txt",
    "adb-admin-password.txt",
    "wallet-password.txt"
  ],
  "post_apply": null
}
