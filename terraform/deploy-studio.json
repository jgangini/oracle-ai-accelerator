{
  "schema_version": 2,
  "project_id": "oracle-ai-accelerator",
  "terraform": {
    "path": "terraform",
    "package_oci_credentials": true
  },
  "capabilities": {
    "compartment_modes": [
      "new",
      "existing"
    ],
    "requires_genai_region": true,
    "database_profile": "new",
    "default_compartment_name": "oracle-ai-accelerator",
    "region_selection": "config"
  },
  "form": {
    "groups": [
      {
        "id": "credentials",
        "title": "OCI credentials",
        "items": [
          {
            "kind": "control",
            "name": "oci_config",
            "label": "OCI config",
            "span": 1
          },
          {
            "kind": "control",
            "name": "oci_key",
            "label": "API private key",
            "span": 1
          }
        ]
      },
      {
        "id": "services",
        "title": "Services to deploy",
        "items": [
          {
            "kind": "control",
            "name": "oci_region",
            "label": "OCI region",
            "span": 2
          },
          {
            "kind": "control",
            "name": "compartment_mode",
            "label": "Compartment mode",
            "span": 1,
            "options": [
              {
                "value": "new",
                "label": "New compartment"
              },
              {
                "value": "existing",
                "label": "Existing compartment"
              }
            ]
          },
          {
            "kind": "control",
            "name": "new_compartment",
            "label": "New compartment name",
            "span": 1
          },
          {
            "kind": "control",
            "name": "existing_compartment",
            "label": "Existing compartment",
            "span": 1
          }
        ]
      },
      {
        "id": "database",
        "title": "Autonomous Database",
        "items": [
          {
            "kind": "field",
            "name": "autonomous_database_admin_password"
          },
          {
            "kind": "field",
            "name": "autonomous_database_wallet_password"
          }
        ]
      },
      {
        "id": "application_vm",
        "title": "Application VM",
        "items": [
          {
            "kind": "field",
            "name": "autonomous_database_developer_password"
          }
        ]
      }
    ],
    "fields": [
      {
        "name": "autonomous_database_admin_password",
        "label": "Database ADMIN password",
        "type": "password",
        "required": true,
        "secret": true,
        "group": "database",
        "generate_password": true,
        "min_length": 12,
        "max_length": 30
      },
      {
        "name": "autonomous_database_wallet_password",
        "label": "Database wallet password",
        "type": "password",
        "required": true,
        "secret": true,
        "group": "database",
        "generate_password": true,
        "min_length": 12,
        "max_length": 30
      },
      {
        "name": "autonomous_database_developer_password",
        "label": "Application password",
        "type": "password",
        "required": true,
        "secret": true,
        "group": "application_vm",
        "generate_password": true,
        "min_length": 12,
        "max_length": 30
      }
    ],
    "email_access_fields": [
      "autonomous_database_admin_password",
      "autonomous_database_wallet_password",
      "autonomous_database_developer_password"
    ]
  },
  "presentation": {
    "title": "Oracle AI Accelerator",
    "summary": "Deploys an OCI solution for document, image, audio and text intelligence with Oracle AI Database, Generative AI and vector workflows.",
    "tags": [
      "Oracle AI Database 26ai",
      "Generative AI",
      "Agents",
      "Select AI"
    ],
    "image": "/assets/oracle-ai-accelerator.png",
    "image_alt": "Oracle AI Accelerator sign-in preview",
    "href": "https://github.com/jgangini/oracle-ai-accelerator"
  },
  "run_steps": [
    {
      "key": "queue",
      "label": "Queue"
    },
    {
      "key": "credentials",
      "label": "OCI credentials"
    },
    {
      "key": "compartment",
      "label": "Compartment"
    },
    {
      "key": "policies",
      "label": "IAM policies"
    },
    {
      "key": "stack",
      "label": "Resource Manager stack"
    },
    {
      "key": "plan",
      "label": "Terraform plan"
    },
    {
      "key": "apply",
      "label": "Terraform apply"
    },
    {
      "key": "application",
      "label": "Application setup"
    },
    {
      "key": "artifacts",
      "label": "Access artifacts"
    },
    {
      "key": "email",
      "label": "Access email"
    },
    {
      "key": "complete",
      "label": "Ready"
    }
  ],
  "outputs": [
    "application_url",
    "ssh_user",
    "adb_db_name",
    "autonomous_database_id",
    "bucket_name"
  ],
  "artifacts": [
    "adb_wallet.zip",
    "ssh-private-key.pem"
  ],
  "post_apply": null,
  "execution_source": "oci_resource_manager",
  "email": {
    "services": [
      {
        "title": "Autonomous Database",
        "fields": [
          {
            "label": "User",
            "value": "ADMIN"
          },
          {
            "label": "Password",
            "input": "autonomous_database_admin_password"
          },
          {
            "label": "Wallet Password",
            "input": "autonomous_database_wallet_password"
          }
        ]
      },
      {
        "title": "Application VM",
        "fields": [
          {
            "label": "Access URL",
            "output": "application_url",
            "link": true
          },
          {
            "label": "User",
            "value": "admin"
          },
          {
            "label": "Password",
            "input": "autonomous_database_developer_password"
          }
        ]
      }
    ],
    "attachments": [
      "adb_wallet.zip",
      "ssh-private-key.pem",
      "deployment.log",
      "resource-manager-terraform-source.zip"
    ]
  }
}
